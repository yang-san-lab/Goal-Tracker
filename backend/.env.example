# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# 数据库 (SQLite 默认，无需修改；生产环境可切 PostgreSQL)
DATABASE_URL=sqlite:///./data/goal_tracker.db

# JWT 密钥 (换成你自己的随机字符串，生产环境务必修改！)
SECRET_KEY=change-me-to-a-random-secret-string

# DeepSeek API Key (必填！从 https://platform.deepseek.com/api_keys 获取)
DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek API 地址 (默认即可)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI 模型选择
#   deepseek-chat     - 标准对话模型，性价比高（推荐）
#   deepseek-reasoner - 推理模型，更深度但更慢更贵
AI_MODEL=deepseek-chat
